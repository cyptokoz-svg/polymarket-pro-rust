+++ b/src/commands/ws.rs
@@ -0,0 +1,241 @@
+use anyhow::Result;
+use clap::{Args, Subcommand};
+
+use crate::output::OutputFormat;
+use crate::websocket;
+
+#[derive(Args)]
+pub struct WsArgs {
+    #[command(subcommand)]
+    pub command: WsCommand,
+}
+
+#[derive(Subcommand)]
+pub enum WsCommand {
+    /// Stream real-time order book updates for one or more assets
+    Book {
+        /// Asset (token) IDs to subscribe to
+        #[arg(required = true, num_args = 1..)]
+        asset_ids: Vec<String>,
+    },
+
+    /// Stream real-time trade activity (via RTDS)
+    Trades {
+        /// Optional: filter by event slug
+        #[arg(long)]
+        event_slug: Option<String>,
+        /// Optional: filter by market slug
+        #[arg(long)]
+        market_slug: Option<String>,
+    },
+
+    /// Stream real-time crypto price updates (via RTDS)
+    Prices {
+        /// Crypto symbols to track (e.g. BTC, ETH)
+        #[arg(required = true, num_args = 1..)]
+        symbols: Vec<String>,
+    },
+
+    /// Stream user-specific order/trade updates (requires API keys)
+    User {
+        /// CLOB API key
+        #[arg(long, env = "POLYMARKET_CLOB_API_KEY")]
+        api_key: String,
+        /// CLOB API secret
+        #[arg(long, env = "POLYMARKET_CLOB_API_SECRET")]
+        api_secret: String,
+        /// CLOB API passphrase
+        #[arg(long, env = "POLYMARKET_CLOB_API_PASSPHRASE")]
+        api_passphrase: String,
+    },
+}
+
+pub async fn execute(args: WsArgs, output: OutputFormat) -> Result<()> {
+    match args.command {
+        WsCommand::Book { asset_ids } => {
+            let count = asset_ids.len();
+            print_header(&output, &format!("Streaming order book for {count} asset(s)…"));
+
+            websocket::stream_clob_market(asset_ids, |text| {
+                print_ws_event(text, &output);
+            })
+            .await
+        }
+
+        WsCommand::Trades {
+            event_slug,
+            market_slug,
+        } => {
+            print_header(&output, "Streaming live trades…");
+
+            let filters = match (&event_slug, &market_slug) {
+                (Some(slug), _) => Some(format!(r#"{{"event_slug":"{slug}"}}"#)),
+                (_, Some(slug)) => Some(format!(r#"{{"market_slug":"{slug}"}}"#)),
+                _ => None,
+            };
+
+            let topic = websocket::RtdsTopic {
+                topic: "activity".into(),
+                event_type: "trades".into(),
+                filters,
+            };
+
+            websocket::stream_rtds(vec![topic], |text| {
+                print_ws_event(text, &output);
+            })
+            .await
+        }
+
+        WsCommand::Prices { symbols } => {
+            let label = symbols.join(", ");
+            print_header(&output, &format!("Streaming crypto prices: {label}…"));
+
+            let topics: Vec<_> = symbols
+                .into_iter()
+                .map(|sym| websocket::RtdsTopic {
+                    topic: "crypto_prices".into(),
+                    event_type: "update".into(),
+                    filters: Some(format!(r#"{{"symbol":"{sym}"}}"#)),
+                })
+                .collect();
+
+            websocket::stream_rtds(topics, |text| {
+                print_ws_event(text, &output);
+            })
+            .await
+        }
+
+        WsCommand::User {
+            api_key,
+            api_secret,
+            api_passphrase,
+        } => {
+            print_header(&output, "Streaming user events…");
+
+            websocket::stream_clob_user(&api_key, &api_secret, &api_passphrase, |text| {
+                print_ws_event(text, &output);
+            })
+            .await
+        }
+    }
+}
+
+fn print_header(output: &OutputFormat, msg: &str) {
+    match output {
+        OutputFormat::Table => eprintln!("{msg}  (Ctrl-C to stop)"),
+        OutputFormat::Json => {}
+    }
+}
+
+fn print_ws_event(text: &str, output: &OutputFormat) {
+    match output {
+        OutputFormat::Json => {
+            // Pass through raw JSON — one object per line (JSONL).
+            println!("{text}");
+        }
+        OutputFormat::Table => {
+            // Try to pretty-print; fall back to raw text.
+            if let Ok(val) = serde_json::from_str::<serde_json::Value>(text) {
+                print_table_event(&val);
+            } else {
+                println!("{text}");
+            }
+        }
+    }
+}
+
+fn print_table_event(val: &serde_json::Value) {
+    let event_type = val
+        .get("event_type")
+        .or_else(|| val.get("type"))
+        .and_then(|v| v.as_str())
+        .unwrap_or("event");
+
+    let ts = val
+        .get("timestamp")
+        .and_then(|v| v.as_str().or_else(|| v.as_i64().map(|_| "")))
+        .unwrap_or("");
+
+    match event_type {
+        "price_change" => {
+            let asset = val
+                .get("asset_id")
+                .and_then(|v| v.as_str())
+                .map(|s| &s[..s.len().min(12)])
+                .unwrap_or("?");
+            if let Some(changes) = val.get("changes").and_then(|c| c.as_array()) {
+                for ch in changes {
+                    let price = ch.get("price").and_then(|v| v.as_str()).unwrap_or("?");
+                    let side = ch.get("side").and_then(|v| v.as_str()).unwrap_or("?");
+                    let size = ch.get("size").and_then(|v| v.as_str()).unwrap_or("?");
+                    println!("[price_change] {asset}… | {side} {size} @ {price} | ts={ts}");
+                }
+            }
+        }
+        "book" => {
+            let asset = val
+                .get("asset_id")
+                .and_then(|v| v.as_str())
+                .map(|s| &s[..s.len().min(12)])
+                .unwrap_or("?");
+            let bids = val
+                .get("bids")
+                .and_then(|v| v.as_array())
+                .map(|a| a.len())
+                .unwrap_or(0);
+            let asks = val
+                .get("asks")
+                .and_then(|v| v.as_array())
+                .map(|a| a.len())
+                .unwrap_or(0);
+            println!("[book] {asset}… | bids={bids} asks={asks} | ts={ts}");
+        }
+        "last_trade_price" => {
+            let asset = val
+                .get("asset_id")
+                .and_then(|v| v.as_str())
+                .map(|s| &s[..s.len().min(12)])
+                .unwrap_or("?");
+            let price = val.get("price").and_then(|v| v.as_str()).unwrap_or("?");
+            println!("[last_trade] {asset}… | price={price} | ts={ts}");
+        }
+        "trades" => {
+            let price = val
+                .get("payload")
+                .and_then(|p| p.get("price"))
+                .and_then(|v| v.as_str())
+                .unwrap_or("?");
+            let side = val
+                .get("payload")
+                .and_then(|p| p.get("side"))
+                .and_then(|v| v.as_str())
+                .unwrap_or("?");
+            let size = val
+                .get("payload")
+                .and_then(|p| p.get("size"))
+                .and_then(|v| v.as_str())
+                .unwrap_or("?");
+            println!("[trade] {side} {size} @ {price}");
+        }
+        "update" => {
+            let symbol = val
+                .get("payload")
+                .and_then(|p| p.get("symbol"))
+                .and_then(|v| v.as_str())
+                .unwrap_or("?");
+            let value = val
+                .get("payload")
+                .and_then(|p| p.get("value"))
+                .and_then(|v| v.as_f64())
+                .map(|v| format!("{v:.2}"))
+                .unwrap_or_else(|| "?".into());
+            println!("[price] {symbol} = ${value}");
+        }
+        _ => {
+            // Generic fallback.
+            if let Ok(pretty) = serde_json::to_string_pretty(val) {
+                println!("{pretty}");
+            }
+        }
+    }
+}
