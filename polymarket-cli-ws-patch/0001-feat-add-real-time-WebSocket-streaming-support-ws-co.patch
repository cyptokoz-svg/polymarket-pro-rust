diff --git a/src/websocket.rs b/src/websocket.rs
new file mode 100644
index 0000000..45f591a
--- /dev/null
+++ b/src/websocket.rs
@@ -0,0 +1,191 @@
+use std::time::Duration;
+
+use anyhow::{Context, Result};
+use futures_util::{SinkExt, StreamExt};
+use serde::Serialize;
+use tokio::time;
+use tokio_tungstenite::connect_async;
+use tokio_tungstenite::tungstenite::Message;
+
+const CLOB_WS_MARKET: &str = "wss://ws-subscriptions-clob.polymarket.com/ws/market";
+const CLOB_WS_USER: &str = "wss://ws-subscriptions-clob.polymarket.com/ws/user";
+const RTDS_WS: &str = "wss://ws-live-data.polymarket.com";
+
+const PING_INTERVAL: Duration = Duration::from_secs(10);
+const RECONNECT_DELAY: Duration = Duration::from_secs(3);
+const MAX_RECONNECTS: u32 = 10;
+
+// ---------------------------------------------------------------------------
+// CLOB Market Channel
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Serialize)]
+pub struct ClobSubscription {
+    pub assets_ids: Vec<String>,
+    #[serde(rename = "type")]
+    pub channel_type: String,
+}
+
+/// Connect to the CLOB Market WebSocket and stream events for the given asset
+/// IDs. Calls `on_event` for every received message. Automatically reconnects
+/// on disconnect.
+pub async fn stream_clob_market(
+    asset_ids: Vec<String>,
+    mut on_event: impl FnMut(&str),
+) -> Result<()> {
+    let sub = ClobSubscription {
+        assets_ids: asset_ids.clone(),
+        channel_type: "market".into(),
+    };
+    let sub_msg = serde_json::to_string(&sub)?;
+    let mut reconnects = 0u32;
+
+    loop {
+        match connect_and_stream(CLOB_WS_MARKET, &sub_msg, &mut on_event).await {
+            Ok(()) => break Ok(()),
+            Err(e) => {
+                reconnects += 1;
+                if reconnects > MAX_RECONNECTS {
+                    break Err(e).context("max reconnects exceeded");
+                }
+                eprintln!("[ws] disconnected: {e}, reconnecting ({reconnects}/{MAX_RECONNECTS})…");
+                time::sleep(RECONNECT_DELAY).await;
+            }
+        }
+    }
+}
+
+/// Connect to the CLOB User WebSocket (requires API key auth header).
+pub async fn stream_clob_user(
+    api_key: &str,
+    api_secret: &str,
+    api_passphrase: &str,
+    mut on_event: impl FnMut(&str),
+) -> Result<()> {
+    let sub = serde_json::json!({
+        "auth": {
+            "apiKey": api_key,
+            "secret": api_secret,
+            "passphrase": api_passphrase,
+        },
+        "type": "user",
+    });
+    let sub_msg = serde_json::to_string(&sub)?;
+    let mut reconnects = 0u32;
+
+    loop {
+        match connect_and_stream(CLOB_WS_USER, &sub_msg, &mut on_event).await {
+            Ok(()) => break Ok(()),
+            Err(e) => {
+                reconnects += 1;
+                if reconnects > MAX_RECONNECTS {
+                    break Err(e).context("max reconnects exceeded");
+                }
+                eprintln!("[ws] disconnected: {e}, reconnecting ({reconnects}/{MAX_RECONNECTS})…");
+                time::sleep(RECONNECT_DELAY).await;
+            }
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// RTDS (Real-Time Data Socket)
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Serialize)]
+pub struct RtdsSubscription {
+    pub subscriptions: Vec<RtdsTopic>,
+}
+
+#[derive(Debug, Serialize)]
+pub struct RtdsTopic {
+    pub topic: String,
+    #[serde(rename = "type")]
+    pub event_type: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub filters: Option<String>,
+}
+
+/// Connect to the RTDS WebSocket. Subscribes to the given topics and streams
+/// events.
+pub async fn stream_rtds(
+    topics: Vec<RtdsTopic>,
+    mut on_event: impl FnMut(&str),
+) -> Result<()> {
+    let sub = RtdsSubscription {
+        subscriptions: topics,
+    };
+    let sub_msg = serde_json::to_string(&sub)?;
+    let mut reconnects = 0u32;
+
+    loop {
+        match connect_and_stream(RTDS_WS, &sub_msg, &mut on_event).await {
+            Ok(()) => break Ok(()),
+            Err(e) => {
+                reconnects += 1;
+                if reconnects > MAX_RECONNECTS {
+                    break Err(e).context("max reconnects exceeded");
+                }
+                eprintln!("[ws] disconnected: {e}, reconnecting ({reconnects}/{MAX_RECONNECTS})…");
+                time::sleep(RECONNECT_DELAY).await;
+            }
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Shared helper
+// ---------------------------------------------------------------------------
+
+async fn connect_and_stream(
+    url: &str,
+    subscribe_msg: &str,
+    on_event: &mut impl FnMut(&str),
+) -> Result<()> {
+    let (ws, _resp) = connect_async(url)
+        .await
+        .context("failed to connect to WebSocket")?;
+
+    let (mut sink, mut stream) = ws.split();
+
+    // Send subscription message.
+    sink.send(Message::Text(subscribe_msg.into()))
+        .await
+        .context("failed to send subscribe")?;
+
+    let mut ping_interval = time::interval(PING_INTERVAL);
+
+    loop {
+        tokio::select! {
+            _ = ping_interval.tick() => {
+                sink.send(Message::Ping(vec![].into())).await.ok();
+            }
+            msg = stream.next() => {
+                match msg {
+                    Some(Ok(Message::Text(text))) => {
+                        on_event(&text);
+                    }
+                    Some(Ok(Message::Ping(data))) => {
+                        sink.send(Message::Pong(data)).await.ok();
+                    }
+                    Some(Ok(Message::Pong(_))) => {}
+                    Some(Ok(Message::Close(_))) => {
+                        break;
+                    }
+                    Some(Err(e)) => {
+                        return Err(e).context("WebSocket read error");
+                    }
+                    None => break,
+                    _ => {}
+                }
+            }
+            // Ctrl-C graceful shutdown.
+            _ = tokio::signal::ctrl_c() => {
+                sink.send(Message::Close(None)).await.ok();
+                return Ok(());
+            }
+        }
+    }
+
+    anyhow::bail!("WebSocket connection closed by server")
+}
